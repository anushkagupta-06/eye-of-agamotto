{
  "name": "TELEMETRY",
  "subjects": ["telemetry.traces", "telemetry.logs"],
  "retention": "limits",
  "storage": "file",
  "num_replicas": 1,
  "discard": "new",
  "max_age": 86400000000000,
  "max_bytes": 10737418240,
  "max_msg_size": 4194304,
  "duplicate_window": 120000000000,
  "max_msgs": -1,
  "max_consumers": -1,
  "max_msgs_per_subject": -1,
  "allow_direct": true,
  "deny_delete": true,
  "deny_purge": false
}
